# --- Mode ---
POSTING_MODE=approval          # approval | auto
POLL_INTERVAL_MINUTES=20
DRY_RUN=false                  # true = build captions, log them, never call Instagram publish

# --- Web server ---
PUBLIC_BASE_URL=https://poster.example.com   # must match OAuth redirect URIs
PORT=8080
ADMIN_PASSWORD=change-me       # protects /approvals and /connect/* pages

# --- Etsy ---
ETSY_API_KEY=
ETSY_SHARED_SECRET=            # only if required by current Etsy docs
ETSY_SHOP_ID=                  # optional; discovered via /users/me if blank

# --- Instagram / Meta ---
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=                    # filled after connect, or stored in DB

# --- Captions ---
CAPTION_HASHTAGS_FIXED=#handmade #etsyshop
CAPTION_MAX_HASHTAGS=15
CAPTION_CTA=Link in bio to shop
AI_CAPTIONS=false
ANTHROPIC_API_KEY=             # only if AI_CAPTIONS=true
AI_MODEL=                      # set to a current model id from Anthropic docs
AI_VOICE_NOTES=Warm, friendly, short sentences, no hype.

# --- Alerts (choose one or both) ---
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DB_PATH=/data/poster.db
